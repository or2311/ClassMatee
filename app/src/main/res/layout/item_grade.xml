<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E0E0E0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <View
            android:id="@+id/grade_indicator"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="16dp"
            android:background="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/grade_subject_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="מתמטיקה"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/grade_date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="12/05/2024"
                android:textSize="14sp"
                android:textColor="#757575" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_exam_date"
            android:backgroundTint="#F5F5F5">

            <TextView
                android:id="@+id/grade_score_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="95"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary" />
        </FrameLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>